meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{base-url}}/api/login?useCookies=true
  body: json
  auth: inherit
}

params:query {
  useCookies: true
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "example@example.com",
    "password": "Pass"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
