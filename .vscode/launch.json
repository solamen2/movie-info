{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend MovieInfo debug",
            "preLaunchTask": "Publish backend .NET Core project",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/MovieInfoBackend/MovieInfoBackend/bin/Debug/net10.0/MovieInfoBackend.dll",
            "cwd": "${workspaceFolder}/MovieInfoBackend/MovieInfoBackend",
            "launchSettingsFilePath": "${workspaceFolder}/MovieInfoBackend/MovieInfoBackend/Properties/launchSettings.json",
            "launchSettingsProfile": "http (dev)",
            "console": "integratedTerminal",
            "env": {
                "CUSTOMCONNSTR_MOVIE_INFO_LOCAL_DB": "Server=localhost,1433;Database=movieinfo;MultipleActiveResultSets=true;User=sa;Password=$QLServerPWSA;Encrypt=false"
            }
        },
        {
            "name": "Frontend MovieInfo debug",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8081",
            "webRoot": "${workspaceFolder}/movie-info-frontend",
            "preLaunchTask": "Compile and run Vite React App"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Frontend Playwright tests debug",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "playwright-debug-script"
            ],
            "env": {
                // PS: Test Explorer version of these lives in Playwright Test for VSCode -> Settings, and Docker version is in .env file
                "E2E_TEST_LOCAL_BASE_URL": "http://localhost:8081/" // NOTE: Use port 8080 for Docker
                //"E2E_TEST_LOCAL_USERNAME": "localtest@example.com", // NOTE: Comment out to use non-local db, and use .env file
                //"E2E_TEST_LOCAL_PASSWORD": "Pa$sw0rd" // NOTE: Comment out to use non-local db, and use .env file
            },
            "cwd": "${workspaceFolder}/movie-info-frontend"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Frontend Playwright Inspector debug",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "playwright-debug-script"
            ],
            "env": {
                "PWDEBUG": "1",
                "E2E_TEST_LOCAL_BASE_URL": "http://localhost:8081/" // NOTE: Use port 8080 for Docker
                //"E2E_TEST_LOCAL_USERNAME": "localtest@example.com", // NOTE: Comment out to use non-local db, and use .env file
                //"E2E_TEST_LOCAL_PASSWORD": "Pa$sw0rd" // NOTE: Comment out to use non-local db, and use .env file
            },
            "cwd": "${workspaceFolder}/movie-info-frontend"
        }
    ]
}