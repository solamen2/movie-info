meta {
  name: Details (TV Episode)
  type: http
  seq: 10
}

get {
  url: https://api.themoviedb.org/3/tv/:series_id/season/:season_number/episode/:episode_number
  body: none
  auth: inherit
}

params:path {
  episode_number: 7
  season_number: 6
  series_id: 95
}

headers {
  Authorization: Bearer longkeygoeshere
}

settings {
  encodeUrl: true
  timeout: 0
}
