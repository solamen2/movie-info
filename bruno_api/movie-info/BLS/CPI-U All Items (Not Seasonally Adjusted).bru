meta {
  name: CPI-U All Items (Not Seasonally Adjusted)
  type: http
  seq: 2
}

get {
  url: https://data.bls.gov/timeseries/CUUR0000SA0?years_option=all_years
  body: none
  auth: inherit
}

params:query {
  years_option: all_years
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Series CUUR0000SA0: all items in U.S. city average, all urban consumers, not seasonally adjusted, from Jan 1913, as an HTML page with one table row per year. The backend parses the table (see InflationHttpClient).
}
